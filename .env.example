# Copiar a .env antes de docker compose up:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

POSTGRES_DB=smarttraffic
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic

RABBITMQ_DEFAULT_USER=smarttraffic
RABBITMQ_DEFAULT_PASS=smarttraffic

# Orígenes permitidos del WebSocket del tablero (separados por coma).
# En AWS añadir http://<IP-pública> sin barra final.
TRAFFIC_WS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
